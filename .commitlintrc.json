{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "header-max-length": [2, "always", 72],
    "scope-empty": [2, "never"],
    "scope-enum": [
      2,
      "always",
      ["engine", "blocks", "templates", "schema", "prepare", "render", "media", "tools", "workflows", "docker", "examples", "reference", "deps", "release", "docs", "test", "studio"]
    ]
  }
}
